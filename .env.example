# Schwab OAuth credentials must be entered only in an encrypted backend
# secret store. Never replace these placeholders in a committed file.
SCHWAB_CLIENT_ID=replace_in_secure_secret_store
SCHWAB_CLIENT_SECRET=replace_in_secure_secret_store

# Replace with the permanent HTTPS callback registered in the Schwab app.
SCHWAB_CALLBACK_URL=https://api.example.com/schwab/callback
